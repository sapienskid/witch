{
	"name": "witch",
	"version": "1.2.0",
	"description": "Publish Obsidian notes to Ghost sites using the Admin API with frontmatter support and automatic markdown conversion.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"build": "pnpm run typecheck && node esbuild.config.mjs production",
		"lint": "eslint main.ts \"src/**/*.ts\" \"test/**/*.ts\" \"*.mjs\"",
		"lint:fix": "pnpm run lint --fix",
		"test": "tsx --test test/**/*.test.ts",
		"release:check": "pnpm run lint && pnpm run test && pnpm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"deploy": "node deploy.mjs"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"ghost",
		"publishing",
		"blog"
	],
	"author": "Sapienskid",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@microsoft/eslint-plugin-sdl": "^1.1.0",
		"@types/js-yaml": "^4.0.9",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^26.1.1",
		"@typescript-eslint/parser": "^8.64.0",
		"builtin-modules": "5.3.0",
		"esbuild": "0.28.1",
		"eslint": "^9.39.5",
		"eslint-plugin-depend": "^1.5.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"markdown-it": "^14.3.0",
		"obsidian": "^1.13.1",
		"tslib": "2.8.1",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1087.0",
		"js-yaml": "^4.3.0"
	}
}
