{
	"name": "witch",
	"version": "2.0.0",
	"description": "Publishes vault notes to a static Hugo site through a Cloudflare Worker content API.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"build": "pnpm run typecheck && node esbuild.config.mjs production",
		"lint": "eslint main.ts \"src/**/*.ts\" \"test/**/*.ts\" \"*.mjs\"",
		"lint:fix": "pnpm run lint --fix",
		"test": "tsx --test test/**/*.test.ts",
		"release:check": "pnpm run lint && pnpm run test && pnpm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"deploy": "node deploy.mjs"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"cms",
		"hugo",
		"cloudflare"
	],
	"author": "Sapienskid",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^2.0.1",
		"@microsoft/eslint-plugin-sdl": "^1.1.0",
		"@types/node": "^26.1.1",
		"@typescript-eslint/parser": "^8.64.0",
		"esbuild": "0.28.1",
		"eslint": "^9.39.5",
		"eslint-plugin-depend": "^1.5.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "^1.13.1",
		"tslib": "2.8.1",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0"
	},
	"dependencies": {}
}
